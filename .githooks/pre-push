#!/usr/bin/env bash
# ==============================================================================
# Git pre-push hook — 台股股票分析平台 v2
#
# 用途：
#   1. CVE 掃描：後端 OWASP Dependency Check、前端 npm audit
#   2. 品質檢查：前端 lint、typecheck、test；後端 unit tests
# 維護者：Linus（Library 工程師）
# 建立日期：2026-04-22
# 版本：v2（加強品質檢查）
#
# 啟用方式（每位開發者 clone repo 後執行一次）：
#   git config core.hooksPath .githooks
#
# 停用方式（緊急情況才使用，需 Jamie 簽核）：
#   git push --no-verify
#
# 觸發邏輯：
#   - 若 backend/ 有變動 → 跑 unit tests（mvn test）
#   - 若 frontend/ 有變動 → 跑 lint、typecheck、test
#   - 若 backend/ 有 pom.xml 變動 → 跑 CVE 掃描
#   - 若 frontend/ 有 package.json 變動 → 跑 npm audit
#   - 純文件（docs/）變動 → 略過所有檢查
#
# 設計考量：
#   1. 變動偵測避免無關 push 浪費時間
#   2. 品質檢查耗時 1-3 分鐘（無 CVE 掃描時）
#   3. CVE 掃描 5-15 分鐘，僅在依賴檔有變時執行
#   4. 退出碼非 0 即阻斷 push
#   5. 失敗時提示確切的本地修復指令
# ==============================================================================

set -e

# ----- 顏色定義 -----
readonly COLOR_RED='\033[0;31m'
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_YELLOW='\033[1;33m'
readonly COLOR_BLUE='\033[0;34m'
readonly COLOR_RESET='\033[0m'

# ----- 路徑定義 -----
readonly REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly BACKEND_DIR="${REPO_ROOT}/backend"
readonly FRONTEND_DIR="${REPO_ROOT}/frontend"

# ----- 工具函式 -----
log_info() {
    printf "${COLOR_BLUE}[pre-push]${COLOR_RESET} %s\n" "$1"
}

log_success() {
    printf "${COLOR_GREEN}[pre-push]${COLOR_RESET} %s\n" "$1"
}

log_warn() {
    printf "${COLOR_YELLOW}[pre-push]${COLOR_RESET} %s\n" "$1"
}

log_error() {
    printf "${COLOR_RED}[pre-push]${COLOR_RESET} %s\n" "$1"
}

# ----- 變動偵測 -----
# 取得本次 push 涵蓋的 commit 範圍
detect_changes() {
    local target_dir="$1"
    local relative_path="${target_dir#${REPO_ROOT}/}"

    # 若是首次 push（remote 尚無對應 branch），則檢查所有 commit
    if ! git rev-parse --verify "@{u}" >/dev/null 2>&1; then
        # 無 upstream，比對 default branch（main 或 master）
        local default_branch
        default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
        git diff --name-only "origin/${default_branch}...HEAD" 2>/dev/null | grep -q "^${relative_path}/" && return 0 || return 1
    else
        # 有 upstream，比對 upstream
        git diff --name-only "@{u}...HEAD" 2>/dev/null | grep -q "^${relative_path}/" && return 0 || return 1
    fi
}

# 檢查特定檔案是否有變動
detect_file_changes() {
    local target_file="$1"
    local relative_path="${target_file#${REPO_ROOT}/}"

    if ! git rev-parse --verify "@{u}" >/dev/null 2>&1; then
        local default_branch
        default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")
        git diff --name-only "origin/${default_branch}...HEAD" 2>/dev/null | grep -q "^${relative_path}$" && return 0 || return 1
    else
        git diff --name-only "@{u}...HEAD" 2>/dev/null | grep -q "^${relative_path}$" && return 0 || return 1
    fi
}

# ----- 後端單元測試 -----
run_backend_tests() {
    log_info "偵測到 backend/ 變動，執行單元測試..."

    if [[ ! -f "${BACKEND_DIR}/pom.xml" ]]; then
        log_warn "backend/pom.xml 不存在，略過後端測試"
        return 0
    fi

    if [[ ! -f "${BACKEND_DIR}/mvnw" ]]; then
        log_error "找不到 ./mvnw，請確保 Maven Wrapper 已安裝"
        return 1
    fi

    cd "${BACKEND_DIR}"

    log_info "預估耗時：2-5 分鐘"
    local start_time=$(date +%s)

    if ./mvnw -B -q test 2>&1 | tee /tmp/backend_test.log; then
        local end_time=$(date +%s)
        local elapsed=$((end_time - start_time))
        log_success "後端單元測試通過 ✓（耗時 ${elapsed}s）"
        return 0
    else
        log_error "後端單元測試失敗 ✗"
        log_error ""
        log_error "修復指令："
        log_error "  cd backend && ./mvnw test"
        log_error ""
        log_error "失敗摘要："
        grep -E "FAILURE|ERROR|\[ERROR\]" /tmp/backend_test.log | head -10 || true
        log_error ""
        log_error "緊急 bypass（需 Jamie 簽核）：git push --no-verify"
        return 1
    fi
}

# ----- 後端 CVE 掃描 -----
run_backend_cve_scan() {
    log_info "偵測到 backend/pom.xml 變動，執行 OWASP Dependency Check..."

    if [[ ! -f "${BACKEND_DIR}/pom.xml" ]]; then
        log_warn "backend/pom.xml 不存在，略過後端 CVE 掃描"
        return 0
    fi

    if [[ ! -f "${BACKEND_DIR}/mvnw" ]]; then
        log_error "找不到 ./mvnw，請確保 Maven Wrapper 已安裝"
        return 1
    fi

    cd "${BACKEND_DIR}"

    log_info "預估耗時：5-15 分鐘（首次執行需下載 NVD 資料庫）"
    log_info "正在掃描... 報告將輸出至 backend/target/dependency-check-report.html"

    if ./mvnw org.owasp:dependency-check-maven:check -B -q; then
        log_success "後端 CVE 掃描通過 ✓"
        return 0
    else
        log_error "後端 CVE 掃描失敗 ✗"
        log_error "存在 CVSS ≥ 7.0 的高風險漏洞"
        log_error "請查閱報告：${BACKEND_DIR}/target/dependency-check-report.html"
        log_error ""
        log_error "處理步驟："
        log_error "  1. 開啟 HTML 報告確認漏洞清單"
        log_error "  2. 升級對應依賴到安全版本"
        log_error "  3. 若為誤報，於 backend/dependency-check.xml 加入抑制規則"
        log_error "  4. 重新跑 ./mvnw org.owasp:dependency-check-maven:check 確認通過"
        log_error ""
        log_error "緊急 bypass（需 Jamie 簽核）：git push --no-verify"
        return 1
    fi
}

# ----- 前端品質檢查：Lint -----
run_frontend_lint() {
    log_info "執行前端 ESLint..."

    cd "${FRONTEND_DIR}"

    local start_time=$(date +%s)

    if npm run lint 2>&1 | tee /tmp/frontend_lint.log; then
        local end_time=$(date +%s)
        local elapsed=$((end_time - start_time))
        log_success "前端 Lint 通過 ✓（耗時 ${elapsed}s）"
        return 0
    else
        log_error "前端 Lint 失敗 ✗"
        log_error ""
        log_error "修復指令："
        log_error "  cd frontend && npm run lint -- --fix"
        log_error ""
        log_error "失敗摘要："
        grep -E "error:|warning:" /tmp/frontend_lint.log | head -5 || true
        return 1
    fi
}

# ----- 前端品質檢查：TypeScript 型別 -----
run_frontend_typecheck() {
    log_info "執行 TypeScript 型別檢查..."

    cd "${FRONTEND_DIR}"

    local start_time=$(date +%s)

    if npm run type-check 2>&1 | tee /tmp/frontend_typecheck.log; then
        local end_time=$(date +%s)
        local elapsed=$((end_time - start_time))
        log_success "前端 Type-check 通過 ✓（耗時 ${elapsed}s）"
        return 0
    else
        log_error "前端 Type-check 失敗 ✗"
        log_error ""
        log_error "修復指令："
        log_error "  cd frontend && npm run type-check"
        log_error "  或開啟相關檔案修正 TypeScript 型別錯誤"
        log_error ""
        log_error "失敗摘要："
        grep -E "error TS|at " /tmp/frontend_typecheck.log | head -5 || true
        return 1
    fi
}

# ----- 前端品質檢查：單元測試 -----
run_frontend_tests() {
    log_info "執行前端單元測試..."

    cd "${FRONTEND_DIR}"

    local start_time=$(date +%s)

    if npm run test -- --run 2>&1 | tee /tmp/frontend_test.log; then
        local end_time=$(date +%s)
        local elapsed=$((end_time - start_time))
        log_success "前端單元測試通過 ✓（耗時 ${elapsed}s）"
        return 0
    else
        log_error "前端單元測試失敗 ✗"
        log_error ""
        log_error "修復指令："
        log_error "  cd frontend && npm run test:watch"
        log_error "  或修正測試、選擇器等問題後重試"
        log_error ""
        log_error "失敗摘要："
        grep -E "FAIL|ERROR|●" /tmp/frontend_test.log | head -5 || true
        return 1
    fi
}

# ----- 前端 CVE 掃描 -----
run_frontend_cve_scan() {
    log_info "偵測到 frontend/package.json 變動，執行 npm audit..."

    if [[ ! -f "${FRONTEND_DIR}/package.json" ]]; then
        log_warn "frontend/package.json 不存在，略過前端 CVE 掃描"
        return 0
    fi

    if ! command -v npm >/dev/null 2>&1; then
        log_error "找不到 npm 指令，請安裝 Node.js 20+"
        log_error "建議使用 nvm: nvm install 20"
        return 1
    fi

    cd "${FRONTEND_DIR}"

    log_info "正在掃描... 門檻 high 以上即失敗"

    if npm audit --audit-level=high; then
        log_success "前端 CVE 掃描通過 ✓"
        return 0
    else
        log_error "前端 CVE 掃描失敗 ✗"
        log_error "存在 high 或 critical 等級漏洞"
        log_error ""
        log_error "處理步驟："
        log_error "  1. 執行 npm audit 查看完整清單"
        log_error "  2. 嘗試安全修復：npm audit fix"
        log_error "  3. 若仍有殘留，提交 Linus 評估手動升級"
        log_error "  4. 強制修復（⚠️ 高風險）：npm audit fix --force（需雙簽核）"
        log_error ""
        log_error "緊急 bypass（需 Jamie 簽核）：git push --no-verify"
        return 1
    fi
}

# ==============================================================================
# 主流程
# ==============================================================================

main() {
    local start_time=$(date +%s)

    log_info "============================================"
    log_info "  Stock Platform — Pre-Push Quality Gate"
    log_info "  Maintainer: Linus (Library Engineer)"
    log_info "  Version: v2 (Code Quality + CVE)"
    log_info "============================================"

    local backend_changed=false
    local frontend_changed=false
    local backend_pom_changed=false
    local frontend_package_changed=false
    local checks_failed=false

    # 偵測變動範圍
    if detect_changes "${BACKEND_DIR}"; then
        backend_changed=true
    fi

    if detect_changes "${FRONTEND_DIR}"; then
        frontend_changed=true
    fi

    if detect_file_changes "${BACKEND_DIR}/pom.xml"; then
        backend_pom_changed=true
    fi

    if detect_file_changes "${FRONTEND_DIR}/package.json"; then
        frontend_package_changed=true
    fi

    # 都未變動 → 直接通過
    if [[ "${backend_changed}" == "false" && "${frontend_changed}" == "false" ]]; then
        log_info "本次 push 未涉及 backend/ 或 frontend/，略過品質檢查"
        log_success "Pre-push 檢查通過 ✓"
        exit 0
    fi

    log_info ""

    # ===== 後端品質檢查 =====
    if [[ "${backend_changed}" == "true" ]]; then
        if ! run_backend_tests; then
            checks_failed=true
        fi
        log_info ""
    fi

    # ===== 前端品質檢查 =====
    if [[ "${frontend_changed}" == "true" ]]; then
        if ! run_frontend_lint; then
            checks_failed=true
        fi
        log_info ""

        if ! run_frontend_typecheck; then
            checks_failed=true
        fi
        log_info ""

        if ! run_frontend_tests; then
            checks_failed=true
        fi
        log_info ""
    fi

    # ===== 依賴掃描（CVE）=====
    if [[ "${backend_pom_changed}" == "true" ]]; then
        if ! run_backend_cve_scan; then
            checks_failed=true
        fi
        log_info ""
    fi

    if [[ "${frontend_package_changed}" == "true" ]]; then
        if ! run_frontend_cve_scan; then
            checks_failed=true
        fi
        log_info ""
    fi

    # 結論
    local end_time=$(date +%s)
    local total_elapsed=$((end_time - start_time))

    if [[ "${checks_failed}" == "true" ]]; then
        log_error "============================================"
        log_error "  Pre-push 檢查失敗，push 已中止"
        log_error "  總耗時：${total_elapsed}s"
        log_error "============================================"
        log_warn ""
        log_warn "緊急 bypass（需 Jamie 簽核）："
        log_warn "  git push --no-verify"
        exit 1
    fi

    log_success "============================================"
    log_success "  所有品質檢查通過，繼續 push"
    log_success "  總耗時：${total_elapsed}s"
    log_success "============================================"
    exit 0
}

main "$@"
