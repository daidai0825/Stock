<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tw.com.stockplatform</groupId>
        <artifactId>stock-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>stock-chip</artifactId>
    <name>stock-chip</name>
    <description>M-CHIP 籌碼模組（Wave 2）</description>

    <dependencies>
        <dependency>
            <groupId>tw.com.stockplatform</groupId>
            <artifactId>stock-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>tw.com.stockplatform</groupId>
            <artifactId>stock-common</artifactId>
        </dependency>
        <!--
            stock-domain：顯式宣告為直接依賴。
            雖然 stock-infrastructure 已遞移帶入，但測試 classpath 在某些情況下
            無法正確解析遞移依賴，導致 StockChipPO 找不到（影響 ChipServiceImplTest 測試發現）。
            顯式宣告較為穩健，與 stock-quote 採同樣處理。
        -->
        <dependency>
            <groupId>tw.com.stockplatform</groupId>
            <artifactId>stock-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>
</project>
